{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "functionTimeout": "00:05:00",
    "extensions": {
        "serviceBus": {
            "maxConcurrentCalls": 16,
            "prefetchCount": 100,
            "maxDeliveryCount": 3,
            "autoRenewTimeout": "00:05:00"
        }
    }
}