@page "/checkout"
@using BlazorClient.Services
@inject IOrderService OrderService
@inject ILogger<Checkout> Logger

<PageTitle>Checkout</PageTitle>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Checkout</h1>

    @if (isSubmitting)
    {
        <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-4">
            <p>Processing your order...</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            <p>@message</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <p>@error</p>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Order Summary -->
        <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-xl font-semibold mb-4">Order Summary</h2>

            @foreach (var item in orderItems)
            {
                <div class="flex justify-between items-center py-2 border-b">
                    <div>
                        <div class="font-medium">@item.ProductName</div>
                        <div class="text-sm text-gray-500">Qty: @item.Quantity × $@item.UnitPrice.ToString("F2")</div>
                    </div>
                    <div class="font-medium">$@((item.Quantity * item.UnitPrice).ToString("F2"))</div>
                </div>
            }

            <div class="mt-4 pt-4 border-t">
                <div class="flex justify-between items-center text-lg font-semibold">
                    <span>Total:</span>
                    <span>$@totalAmount.ToString("F2")</span>
                </div>
            </div>
        </div>

        <!-- Checkout Form -->
        <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-xl font-semibold mb-4">Payment & Shipping</h2>

            <EditForm Model="checkoutForm" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <!-- Customer Information -->
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Customer ID</label>
                    <InputText @bind-Value="checkoutForm.CustomerId"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md" />
                    <ValidationMessage For="() => checkoutForm.CustomerId" />
                </div>

                <!-- Shipping Address -->
                <div class="mb-6">
                    <h3 class="text-lg font-medium mb-3">Shipping Address</h3>

                    <div class="mb-3">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Street</label>
                        <InputText @bind-Value="checkoutForm.ShippingStreet"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md" />
                        <ValidationMessage For="() => checkoutForm.ShippingStreet" />
                    </div>

                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
                            <InputText @bind-Value="checkoutForm.ShippingCity"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md" />
                            <ValidationMessage For="() => checkoutForm.ShippingCity" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
                            <InputText @bind-Value="checkoutForm.ShippingState"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md" />
                            <ValidationMessage For="() => checkoutForm.ShippingState" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Postal Code</label>
                            <InputText @bind-Value="checkoutForm.ShippingPostalCode"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md" />
                            <ValidationMessage For="() => checkoutForm.ShippingPostalCode" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                            <InputText @bind-Value="checkoutForm.ShippingCountry"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md" />
                            <ValidationMessage For="() => checkoutForm.ShippingCountry" />
                        </div>
                    </div>
                </div>

                <!-- Payment Information -->
                <div class="mb-6">
                    <h3 class="text-lg font-medium mb-3">Payment Information</h3>

                    <div class="mb-3">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Payment Method ID</label>
                        <InputText @bind-Value="checkoutForm.PaymentMethodId"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md" />
                        <ValidationMessage For="() => checkoutForm.PaymentMethodId" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Card Type</label>
                            <InputSelect @bind-Value="checkoutForm.PaymentMethodType"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md">
                                <option value="">Select type</option>
                                <option value="card">Credit Card</option>
                                <option value="bank_account">Bank Account</option>
                            </InputSelect>
                            <ValidationMessage For="() => checkoutForm.PaymentMethodType" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Last 4 Digits</label>
                            <InputText @bind-Value="checkoutForm.PaymentMethodLastFour"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md" maxlength="4" />
                            <ValidationMessage For="() => checkoutForm.PaymentMethodLastFour" />
                        </div>
                    </div>
                </div>

                <button type="submit" disabled="@isSubmitting"
                    class="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-gray-400 text-white font-medium py-3 px-4 rounded-md transition">
                    @if (isSubmitting)
                    {
                        <span>Processing Order...</span>
                    }
                    else
                    {
                        <span>Place Order ($@totalAmount.ToString("F2"))</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private CheckoutFormModel checkoutForm = new();
    private List<OrderItemRequest> orderItems = new();
    private decimal totalAmount = 0;
    private bool isSubmitting = false;
    private string message = "";
    private string error = "";

    protected override void OnInitialized()
    {
        // Sample order items for demonstration
        orderItems = new List<OrderItemRequest>
{
new() { ProductId = "prod_1", ProductName = "Sample Product 1", Quantity = 2, UnitPrice = 29.99m },
new() { ProductId = "prod_2", ProductName = "Sample Product 2", Quantity = 1, UnitPrice = 49.99m }
};

        totalAmount = orderItems.Sum(item => item.Quantity * item.UnitPrice);

        // Initialize form with defaults
        checkoutForm = new CheckoutFormModel
        {
            CustomerId = "cust_" + Guid.NewGuid().ToString()[0..8],
            ShippingCountry = "US",
            PaymentMethodType = "card"
        };
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        message = "";
        error = "";

        try
        {
            var request = new OrderSubmissionRequest
            {
                CustomerId = checkoutForm.CustomerId,
                TotalAmount = totalAmount,
                Currency = "USD",
                PaymentMethodId = checkoutForm.PaymentMethodId,
                PaymentMethodType = checkoutForm.PaymentMethodType,
                PaymentMethodLastFour = checkoutForm.PaymentMethodLastFour,
                Items = orderItems,
                ShippingAddress = new ShippingAddressRequest
                {
                    Street = checkoutForm.ShippingStreet,
                    City = checkoutForm.ShippingCity,
                    State = checkoutForm.ShippingState,
                    PostalCode = checkoutForm.ShippingPostalCode,
                    Country = checkoutForm.ShippingCountry
                }
            };

            var result = await OrderService.SubmitOrderAsync(request);

            if (result.Success)
            {
                message = $"Order {result.OrderId} submitted successfully! Status: {result.Status}";
                Logger.LogInformation("Order submitted successfully: {OrderId}", result.OrderId);

                // Reset form
                checkoutForm = new CheckoutFormModel
                {
                    CustomerId = "cust_" + Guid.NewGuid().ToString()[0..8],
                    ShippingCountry = "US",
                    PaymentMethodType = "card"
                };
            }
            else
            {
                error = result.Error ?? "Unknown error occurred";
                Logger.LogError("Order submission failed: {Error}", error);
            }
        }
        catch (Exception ex)
        {
            error = "An unexpected error occurred. Please try again.";
            Logger.LogError(ex, "Exception during order submission");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class CheckoutFormModel
    {
        [Required]
        public string CustomerId { get; set; } = "";

        [Required]
        public string ShippingStreet { get; set; } = "";

        [Required]
        public string ShippingCity { get; set; } = "";

        [Required]
        public string ShippingState { get; set; } = "";

        [Required]
        public string ShippingPostalCode { get; set; } = "";

        [Required]
        public string ShippingCountry { get; set; } = "";

        [Required]
        public string PaymentMethodId { get; set; } = "";

        [Required]
        public string PaymentMethodType { get; set; } = "";

        [Required]
        [StringLength(4, MinimumLength = 4)]
        public string PaymentMethodLastFour { get; set; } = "";
    }
}