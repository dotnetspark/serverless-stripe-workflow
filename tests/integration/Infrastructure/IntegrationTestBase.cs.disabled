    {
        ["1"] = new ProductDto { Id = "1", Title = "Test Product 1", Price = 29.99m, Category = "electronics" },
        ["2"] = new ProductDto { Id = "2", Title = "Test Product 2", Price = 19.99m, Category = "clothing" },
        ["3"] = new ProductDto { Id = "3", Title = "Test Product 3", Price = 39.99m, Category = "books" },
        ["4"] = new ProductDto { Id = "4", Title = "Test Product 4", Price = 49.99m, Category = "electronics" },
        ["5"] = new ProductDto { Id = "5", Title = "Test Product 5", Price = 15.99m, Category = "clothing" }
    };

    public MockProductService(ILogger<MockProductService> logger)
    {
        _logger = logger;
    }

    public async Task<Product?> GetProductByIdAsync(string id)
    {
        await Task.Delay(50); // Simulate API call
        _products.TryGetValue(productId, out var product);
        _logger.LogInformation($"Retrieved product {productId}: {(product != null ? product.Title : "Not Found")}");
        return product;
    }

    public async Task<IEnumerable<Product>> GetProductsAsync()
    {
        await Task.Delay(100); // Simulate API call
        var products = _products.Values.Select(dto => new Product
        {
            Id = dto.Id,
            Title = dto.Title,
            Price = dto.Price,
            Category = dto.Category,
            Description = dto.Description,
            Image = dto.Image
        }).ToList();

        _logger.LogInformation($"Retrieved {products.Count} products");
        return products;
    }

    public async Task<IEnumerable<Product>> GetProductsByCategoryAsync(string category)
    {
        await Task.Delay(100); // Simulate API call
        var products = _products.Values.AsEnumerable();

        if (!string.IsNullOrEmpty(category))
        {
            products = products.Where(p => p.Category.Equals(category, StringComparison.OrdinalIgnoreCase));
        }

        products = products.Take(limit);
        var result = products.ToList();

        var products = _products.Values
            .Where(p => p.Category.Equals(category, StringComparison.OrdinalIgnoreCase))
            .Select(dto => new Product
            {
                Id = dto.Id,
                Title = dto.Title,
                Price = dto.Price,
                Category = dto.Category,
                Description = dto.Description,
